<Window x:Class="FaceProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FaceProcessor.Views"
        Title="FaceProcessor"
        Width="1640"
        Height="1040"
        MinWidth="1460"
        MinHeight="920"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="24"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF5FF" Offset="0" />
                <GradientStop Color="#D8ECFF" Offset="0.42" />
                <GradientStop Color="#CFE5FB" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="520"
                     Height="520"
                     Canvas.Left="-120"
                     Canvas.Top="-100"
                     Fill="#66FFFFFF" />
            <Ellipse Width="420"
                     Height="420"
                     Canvas.Right="-40"
                     Canvas.Top="80"
                     Fill="#4DBFE1FF" />
            <Ellipse Width="680"
                     Height="680"
                     Canvas.Left="460"
                     Canvas.Bottom="-340"
                     Fill="#403E8DFF" />
        </Canvas>

        <Border x:Name="ShellFrame"
                Margin="18"
                Style="{StaticResource ShellBorder}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource TitleBarBrush}"
                        BorderBrush="#6BFFFFFF"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid Margin="16,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource TitleBarLogoBadge}">
                                <Image x:Name="TitleBarLogoImage"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="FaceProcessor" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Text="AI 人脸处理工作台" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Click="MinimizeButton_Click"
                                    Style="{StaticResource TitleBarButton}"
                                    ToolTip="最小化">
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="－" />
                            </Button>
                            <Button Click="MaximizeButton_Click"
                                    Style="{StaticResource TitleBarButton}"
                                    ToolTip="最大化或还原">
                                <TextBlock x:Name="MaximizeGlyphText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="□" />
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Style="{StaticResource TitleBarCloseButton}"
                                    ToolTip="关闭">
                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="×" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="30,24,30,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource WindowIconBadge}">
                            <Image x:Name="HeaderLogoImage"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="FaceProcessor"
                                       Style="{StaticResource HeroTitle}" />
                            <TextBlock Text="本地图片与视频人脸处理，界面与加速链路已重新整理。"
                                       Style="{StaticResource HeroSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource HeroSubtitle}"
                               Text="玻璃风界面 · GPU 检测优先 · NVENC 视频输出" />

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <Border Margin="0,0,0,8"
                                Style="{StaticResource RuntimeBadgeBorder}">
                            <TextBlock x:Name="DetectorBadgeText"
                                       Style="{StaticResource RuntimeBadgeText}"
                                       Text="检测后端：初始化中" />
                        </Border>
                        <Border Style="{StaticResource RuntimeBadgeBorder}">
                            <TextBlock x:Name="EncoderBadgeText"
                                       Style="{StaticResource RuntimeBadgeText}"
                                       Text="编码后端：初始化中" />
                        </Border>
                    </StackPanel>
                </Grid>

                <TabControl x:Name="MainTabControl"
                            Grid.Row="2"
                            Margin="24,0,24,24"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource ThemedTabControl}">
                    <TabItem Header="图片处理"
                             Style="{StaticResource ThemedTabItem}">
                        <views:ImageTabView x:Name="ImageTab" />
                    </TabItem>
                    <TabItem Header="视频处理"
                             Style="{StaticResource ThemedTabItem}">
                        <views:VideoTabView x:Name="VideoTab" />
                    </TabItem>
                    <TabItem Header="日志"
                             Style="{StaticResource ThemedTabItem}">
                        <views:LogTabView x:Name="LogTab" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
