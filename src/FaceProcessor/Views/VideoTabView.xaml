<UserControl x:Class="FaceProcessor.Views.VideoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 视频选择区 -->
            <GroupBox Grid.Row="0" Header="🎬 视频文件" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="VideoPathTextBox" Width="400" IsReadOnly="True"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,0,10,0"/>
                        <Button Content="📁 选择视频" Click="SelectVideo_Click" 
                                Style="{DynamicResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBlock Name="GpuStatusText" Text="⚠️ CPU 模式（较慢）" 
                               Foreground="#FFA726" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 处理设置区 -->
            <GroupBox Grid.Row="1" Header="⚙️ 处理设置" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="处理模式" VerticalAlignment="Center" Width="70" Foreground="#AAAAAA"/>
                    <ComboBox Name="ModeCombo" Width="100" SelectedIndex="0" 
                              Style="{DynamicResource ModernComboBox}">
                        <ComboBoxItem Content="马赛克"/>
                        <ComboBoxItem Content="高斯模糊"/>
                    </ComboBox>
                    
                    <TextBlock Text="块大小" VerticalAlignment="Center" Margin="25,0,0,0" 
                               Width="50" Foreground="#AAAAAA"/>
                    <TextBox Name="BlockSizeTextBox" Width="50" Text="0" 
                             Style="{DynamicResource ModernTextBox}"/>
                    <TextBlock Text="(0=自动)" VerticalAlignment="Center" Margin="5,0,0,0" 
                               Foreground="#888888"/>
                    
                    <TextBlock Text="模糊强度" VerticalAlignment="Center" Margin="25,0,0,0" 
                               Width="60" Foreground="#AAAAAA"/>
                    <TextBox Name="BlurStrengthTextBox" Width="50" Text="99" 
                             Style="{DynamicResource ModernTextBox}"/>
                </StackPanel>
            </GroupBox>

            <!-- 输出设置区 -->
            <GroupBox Grid.Row="2" Header="📁 输出设置" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="OutputPathTextBox" Width="400" 
                                 Style="{DynamicResource ModernTextBox}" Margin="0,0,10,0"/>
                        <Button Content="浏览..." Click="BrowseOutput_Click" 
                                Style="{DynamicResource PrimaryButton}"/>
                    </StackPanel>
                    <CheckBox Name="KeepAudioCheckBox" Content="🔊 保留音频" 
                              IsChecked="True" Foreground="#CCCCCC" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 进度和按钮 -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border Background="#2A2A4A" CornerRadius="10" Padding="3" Margin="0,0,0,10">
                    <ProgressBar Name="ProgressBar" Height="20" Background="Transparent" 
                                 Foreground="{DynamicResource SuccessButtonGradient}" Value="0"
                                 BorderThickness="0"/>
                </Border>
                <TextBlock Name="ProgressText" Text="" Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Name="StatusText" Text="就绪" Foreground="#CCCCCC" 
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="ProcessBtn" Content="▶ 开始处理" Click="Process_Click"
                            Style="{DynamicResource SuccessButton}" Padding="40,15" FontSize="16" 
                            Margin="0,0,20,0"/>
                    <Button Name="CancelBtn" Content="⏹ 取消" Click="Cancel_Click"
                            Style="{DynamicResource DangerButton}" Padding="25,15" FontSize="16" 
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
