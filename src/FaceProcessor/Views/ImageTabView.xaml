<UserControl x:Class="FaceProcessor.Views.ImageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 文件选择区 -->
            <GroupBox Grid.Row="0" Header="📂 文件列表" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="📷 选择图片" Click="SelectImages_Click" 
                                Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="📁 选择文件夹" Click="SelectFolder_Click" 
                                Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="🗑️ 清空" Click="ClearFiles_Click" 
                                Style="{DynamicResource DangerButton}"/>
                    </StackPanel>
                    <Border Background="#2A2A4A" CornerRadius="8" Margin="5" Padding="5">
                        <ListBox Name="ImageListBox" Height="120" Background="Transparent" 
                                 Foreground="#CCCCCC" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 处理设置区 -->
            <GroupBox Grid.Row="1" Header="⚙️ 处理设置" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="处理方式" VerticalAlignment="Center" Width="80" Foreground="#AAAAAA"/>
                        <ComboBox Name="ModeCombo" Width="120" SelectedIndex="1" 
                                  Style="{DynamicResource ModernComboBox}">
                            <ComboBoxItem Content="不处理"/>
                            <ComboBoxItem Content="马赛克"/>
                            <ComboBoxItem Content="高斯模糊"/>
                            <ComboBoxItem Content="黑丝网格"/>
                            <ComboBoxItem Content="网格线"/>
                            <ComboBoxItem Content="拆分图"/>
                        </ComboBox>
                        
                        <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="25,0,0,0" 
                                   Width="55" Foreground="#AAAAAA"/>
                        <ComboBox Name="ResolutionCombo" Width="100" SelectedIndex="0" 
                                  Style="{DynamicResource ModernComboBox}">
                            <ComboBoxItem Content="不限"/>
                            <ComboBoxItem Content="≤1024px"/>
                            <ComboBoxItem Content="≤2048px"/>
                        </ComboBox>
                        
                        <TextBlock Text="格式" VerticalAlignment="Center" Margin="25,0,0,0" 
                                   Width="40" Foreground="#AAAAAA"/>
                        <ComboBox Name="FormatCombo" Width="70" SelectedIndex="0" 
                                  Style="{DynamicResource ModernComboBox}">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="WEBP"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="导出质量" VerticalAlignment="Center" Width="80" Foreground="#AAAAAA"/>
                        <Slider Name="QualitySlider" Minimum="10" Maximum="100" Value="95" 
                                Width="250" TickFrequency="5" IsSnapToTickEnabled="True"
                                Foreground="#6C63FF"/>
                        <TextBlock Name="QualityText" Text="95%" VerticalAlignment="Center" 
                                   Margin="15,0,0,0" Foreground="#CCCCCC"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 输出设置区 -->
            <GroupBox Grid.Row="2" Header="📁 输出设置" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Name="CustomPathRadio" Content="自定义目录" 
                                     Foreground="#CCCCCC" IsChecked="True" Margin="0,0,25,0"/>
                        <RadioButton Name="SubfolderRadio" Content="源目录子文件夹" Foreground="#CCCCCC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="OutputPathTextBox" Width="400" 
                                 Style="{DynamicResource ModernTextBox}" Margin="0,0,10,0"/>
                        <Button Content="浏览..." Click="BrowseOutput_Click" 
                                Style="{DynamicResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBox Name="SubfolderNameTextBox" Width="200" Text="processed" 
                             Style="{DynamicResource ModernTextBox}" Margin="0,10,0,0"
                             IsEnabled="{Binding IsChecked, ElementName=SubfolderRadio}"/>
                </StackPanel>
            </GroupBox>

            <!-- 进度和按钮 -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border Background="#2A2A4A" CornerRadius="10" Padding="3" Margin="0,0,0,15">
                    <ProgressBar Name="ProgressBar" Height="20" Background="Transparent" 
                                 Foreground="{DynamicResource ProgressBarGradient}" Value="0"
                                 BorderThickness="0"/>
                </Border>
                <TextBlock Name="StatusText" Text="就绪" Foreground="#CCCCCC" 
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Button Name="ProcessBtn" Content="▶ 开始处理" 
                        Click="Process_Click" Style="{DynamicResource SuccessButton}"
                        HorizontalAlignment="Center" Padding="40,15" FontSize="16"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
