<UserControl x:Class="FaceProcessor.Views.ImageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <LinearGradientBrush x:Key="PrimaryBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2196F3" Offset="0"/>
            <GradientStop Color="#21CBF3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F44336" Offset="0"/>
            <GradientStop Color="#E91E63" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#8BC34A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2196F3" Offset="0"/>
            <GradientStop Color="#9C27B0" Offset="0.5"/>
            <GradientStop Color="#E91E63" Offset="1"/>
        </LinearGradientBrush>
        
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button" x:Key="SuccessBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource SuccessBtnGrad}"/>
        </Style>
        
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBtnGrad}"/>
        </Style>
        
        <!-- ComboBox 基础样式 - 保留默认模板，只修改颜色 -->
        <Style TargetType="ComboBox" x:Key="ModernCb">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      x:Name="ContentSite"
                                                      Margin="8,6,0,6"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          x:Name="Arrow"
                                          Fill="#888888"
                                          Stretch="Uniform"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L5,5 L10,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   BorderThickness="0">
                                <Border Background="#2A2A4A"
                                        BorderBrush="#404060"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="300">
                                    <ScrollViewer SnapsToDevicePixels="True" Margin="4">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#606080"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#64B5F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#64B5F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ComboBox 下拉项样式 -->
        <Style x:Key="ModernCbItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A5A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4A4A6A"/>
                                <Setter Property="Foreground" Value="#64B5F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBox" x:Key="ModernTb">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 文件选择区 -->
            <GroupBox Grid.Row="0" Header="📂 文件列表" Foreground="White" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="📷 选择图片" Click="SelectImages_Click" 
                                Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="📁 选择文件夹" Click="SelectFolder_Click" 
                                Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="🗑️ 清空" Click="ClearFiles_Click" 
                                Style="{StaticResource DangerBtn}"/>
                    </StackPanel>
                    <Border Background="#2A2A4A" CornerRadius="8" Margin="5" Padding="5">
                        <ListBox Name="ImageListBox" Height="120" Background="Transparent" 
                                 Foreground="#CCCCCC" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 处理设置区 -->
            <GroupBox Grid.Row="1" Header="⚙️ 处理设置" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="处理方式" VerticalAlignment="Center" Width="80" Foreground="#AAAAAA"/>
                        <ComboBox Name="ModeCombo" Width="120" SelectedIndex="1" Style="{StaticResource ModernCb}" ItemContainerStyle="{StaticResource ModernCbItem}">
                            <ComboBoxItem Content="不处理"/>
                            <ComboBoxItem Content="马赛克"/>
                            <ComboBoxItem Content="高斯模糊"/>
                            <ComboBoxItem Content="黑丝网格"/>
                            <ComboBoxItem Content="网格线"/>
                            <ComboBoxItem Content="拆分图"/>
                        </ComboBox>
                        
                        <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="25,0,0,0" 
                                   Width="55" Foreground="#AAAAAA"/>
                        <ComboBox Name="ResolutionCombo" Width="100" SelectedIndex="0" Style="{StaticResource ModernCb}" ItemContainerStyle="{StaticResource ModernCbItem}">
                            <ComboBoxItem Content="不限"/>
                            <ComboBoxItem Content="≤1024px"/>
                            <ComboBoxItem Content="≤2048px"/>
                        </ComboBox>
                        
                        <TextBlock Text="格式" VerticalAlignment="Center" Margin="25,0,0,0" 
                                   Width="40" Foreground="#AAAAAA"/>
                        <ComboBox Name="FormatCombo" Width="70" SelectedIndex="0" Style="{StaticResource ModernCb}" ItemContainerStyle="{StaticResource ModernCbItem}">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="WEBP"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="导出质量" VerticalAlignment="Center" Width="80" Foreground="#AAAAAA"/>
                        <Slider Name="QualitySlider" Minimum="10" Maximum="100" Value="95" 
                                Width="250" TickFrequency="5" IsSnapToTickEnabled="True"
                                Foreground="#6C63FF"/>
                        <TextBlock Name="QualityText" Text="95%" VerticalAlignment="Center" 
                                   Margin="15,0,0,0" Foreground="#CCCCCC"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 输出设置区 -->
            <GroupBox Grid.Row="2" Header="📁 输出设置" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Name="CustomPathRadio" Content="自定义目录" 
                                     Foreground="#CCCCCC" IsChecked="True" Margin="0,0,25,0"/>
                        <RadioButton Name="SubfolderRadio" Content="源目录子文件夹" Foreground="#CCCCCC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="OutputPathTextBox" Width="400" 
                                 Style="{StaticResource ModernTb}" Margin="0,0,10,0"/>
                        <Button Content="浏览..." Click="BrowseOutput_Click" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                    <TextBox Name="SubfolderNameTextBox" Width="200" Text="processed" 
                             Style="{StaticResource ModernTb}" Margin="0,10,0,0"
                             IsEnabled="{Binding IsChecked, ElementName=SubfolderRadio}"/>
                </StackPanel>
            </GroupBox>

            <!-- 进度和按钮 -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border Background="#2A2A4A" CornerRadius="10" Padding="3" Margin="0,0,0,15">
                    <ProgressBar Name="ProgressBar" Height="20" Background="Transparent" 
                                 Foreground="{StaticResource ProgressGrad}" Value="0"
                                 BorderThickness="0"/>
                </Border>
                <TextBlock Name="StatusText" Text="就绪" Foreground="#CCCCCC" 
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Button Name="ProcessBtn" Content="▶ 开始处理" 
                        Click="Process_Click" Style="{StaticResource SuccessBtn}"
                        HorizontalAlignment="Center" Padding="40,15" FontSize="16"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
