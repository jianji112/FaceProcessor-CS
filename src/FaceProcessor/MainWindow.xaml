<Window x:Class="FaceProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FaceProcessor.Views"
        Title="Face Processor" Height="780" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundGradient}"
        AllowsTransparency="False">
    
    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
    </Window.Effect>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🔷" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Face Processor" FontSize="32" FontWeight="Bold" 
                       Foreground="{DynamicResource TitleGradient}" VerticalAlignment="Center"/>
            <TextBlock Text="v1.0" FontSize="14" Foreground="#888888" 
                       VerticalAlignment="Bottom" Margin="10,0,0,5"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,0,0,15" Background="#404060" Height="1"/>

        <!-- 标签页 -->
        <TabControl Grid.Row="2" Name="MainTabControl" Background="Transparent" 
                     BorderThickness="0" Padding="0">
            <TabItem Header="📷 图片处理">
                <Grid Name="ImageTabContainer" Margin="0,10,0,0"/>
            </TabItem>
            <TabItem Header="🎬 视频处理">
                <Grid Name="VideoTabContainer" Margin="0,10,0,0"/>
            </TabItem>
            <TabItem Header="ℹ️ 关于">
                <ScrollViewer Margin="20">
                    <StackPanel>
                        <TextBlock Text="Face Processor" FontSize="24" FontWeight="Bold" 
                                   Foreground="{DynamicResource TitleGradient}"/>
                        <TextBlock Text="人脸处理工具 - 支持 GPU 加速" FontSize="14" 
                                   Foreground="#AAAAAA" Margin="0,5,0,20"/>
                        
                        <TextBlock Text="功能特性" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#CCCCCC" Margin="0,10,0,10"/>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,10">
                            • 图片处理：马赛克、高斯模糊、黑丝网格、网格线、拆分图
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,10">
                            • 视频处理：逐帧人脸检测与打码，支持音频保留
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,10">
                            • GPU 加速：CUDA 加速人脸检测（需要 NVIDIA 显卡）
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,10">
                            • 批量处理：支持文件夹批量处理
                        </TextBlock>
                        
                        <TextBlock Text="技术栈" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#CCCCCC" Margin="0,20,0,10"/>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,5">
                            • UI: WPF (.NET 8)
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,5">
                            • 人脸检测: ONNX Runtime + YOLOv8-Face
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,5">
                            • 图像处理: OpenCvSharp4
                        </TextBlock>
                        <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap" Margin="10,0,0,5">
                            • 音频处理: Xabe.FFmpeg
                        </TextBlock>
                        
                        <TextBlock Text="版本信息" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#CCCCCC" Margin="0,20,0,10"/>
                        <TextBlock Name="VersionText" Foreground="#AAAAAA" Margin="10,0,0,5">
                            版本: 1.0.0
                        </TextBlock>
                        <TextBlock Foreground="#888888" Margin="10,0,0,5">
                            © 2024 Face Processor
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
