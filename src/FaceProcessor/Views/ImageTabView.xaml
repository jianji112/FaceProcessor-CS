<UserControl x:Class="FaceProcessor.Views.ImageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid"
          Margin="24,0,24,24"
          AllowDrop="True"
          DragEnter="RootDragEnter"
          DragOver="RootDragOver"
          DragLeave="RootDragLeave"
          Drop="RootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,18,18"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Margin="0,0,0,12"
                        Click="SelectImages_Click"
                        Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Margin="0,0,10,0"
                              Fill="#4E94FF"
                              Stretch="Uniform"
                              Data="{StaticResource ImageIconGeometry}" />
                        <TextBlock FontSize="16"
                                   Text="选择图片" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Margin="0,0,0,16"
                        Click="SelectFolder_Click"
                        Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Margin="0,0,10,0"
                              Fill="#4E94FF"
                              Stretch="Uniform"
                              Data="{StaticResource FolderIconGeometry}" />
                        <TextBlock FontSize="16"
                                   Text="选择文件夹" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="2"
                        Padding="10"
                        BorderBrush="#A6D2FF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Background="#8EFFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource SectionTitle}"
                                       Text="待处理列表" />
                            <Button x:Name="ClearFilesBtn"
                                    DockPanel.Dock="Right"
                                    Click="ClearFiles_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Content="清空列表" />
                        </DockPanel>

                        <ListBox x:Name="ImageListBox"
                                 Grid.Row="1"
                                 ItemContainerStyle="{StaticResource ThemedListBoxItem}"
                                 SelectionChanged="ImageListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource ThemedListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,16,0,0">
                    <TextBlock x:Name="SelectedCountText"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="已选择 0 张" />
                    <TextBlock x:Name="DetectorStatusText"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="检测后端：初始化中" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,18,18"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource SectionTitle}"
                               Text="预览画面" />
                    <TextBlock x:Name="PreviewModeText"
                               DockPanel.Dock="Right"
                               Style="{StaticResource CaptionText}"
                               Text="预览模式：等待选择图片" />
                </DockPanel>

                <Border Grid.Row="1"
                        CornerRadius="28"
                        Background="#ECF6FF"
                        BorderBrush="#9FCEFF"
                        BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Margin="20"
                               Stretch="Uniform" />
                        <TextBlock x:Name="PreviewPlaceholderText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Text="选择图片后显示人脸检测预览" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="当前预览会在缩放图上标出检测框，用于确认识别区域。" />
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,0,18"
                Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource SectionTitle}"
                               Text="处理设置" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="处理模式" />
                    <ComboBox x:Name="ModeCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="马赛克" />
                        <ComboBoxItem Content="模糊" />
                        <ComboBoxItem Content="黑网" />
                        <ComboBoxItem Content="网格" />
                        <ComboBoxItem Content="分离" />
                    </ComboBox>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="输出分辨率" />
                    <ComboBox x:Name="ResolutionCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="原分辨率" />
                        <ComboBoxItem Content="最长边 1024" />
                        <ComboBoxItem Content="最长边 2048" />
                    </ComboBox>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="输出格式" />
                    <ComboBox x:Name="FormatCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="PNG" />
                        <ComboBoxItem Content="JPG" />
                        <ComboBoxItem Content="WEBP" />
                    </ComboBox>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="每张图片处理的人脸数" />
                    <ComboBox x:Name="ImageFaceCountCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="只处理 1 张脸" />
                        <ComboBoxItem Content="处理 2 张脸" />
                        <ComboBoxItem Content="处理 3 张脸" />
                        <ComboBoxItem Content="全部处理" />
                    </ComboBox>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource FieldLabel}"
                                   Text="输出质量" />
                        <TextBlock x:Name="QualityText"
                                   DockPanel.Dock="Right"
                                   Style="{StaticResource FieldLabel}"
                                   Text="95%" />
                    </DockPanel>
                    <Slider x:Name="QualitySlider"
                            Minimum="30"
                            Maximum="100"
                            TickFrequency="5"
                            Style="{StaticResource GlassSlider}"
                            Value="95" />

                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="输出路径" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <RadioButton x:Name="CustomPathRadio"
                                     Style="{StaticResource ChoiceChip}"
                                     Content="自定义路径" />
                        <RadioButton x:Name="SubfolderRadio"
                                     Style="{StaticResource ChoiceChip}"
                                     Content="子文件夹" />
                    </StackPanel>

                    <TextBox x:Name="OutputPathTextBox"
                             Margin="0,0,0,10"
                             Style="{StaticResource TextInput}" />
                    <Button Click="BrowseOutput_Click"
                            Style="{StaticResource SecondaryButton}"
                            Content="选择输出目录" />

                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="子文件夹名称" />
                    <TextBox x:Name="SubfolderNameTextBox"
                             Style="{StaticResource TextInput}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="0"
                             Grid.Column="0"
                             Margin="0,0,18,12"
                             Height="14"
                             Maximum="100"
                             Style="{StaticResource ThemedProgressBar}" />
                <TextBlock x:Name="ProgressText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,18,10"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="0%" />
                <Button x:Name="ProcessBtn"
                        Grid.Row="0"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Height="74"
                        Margin="0,0,0,0"
                        Click="Process_Click"
                        Style="{StaticResource PrimaryButton}">
                    <TextBlock FontSize="20"
                               Text="开始处理" />
                </Button>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Vertical">
                    <TextBlock x:Name="StatusText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="等待开始" />
                    <TextBlock x:Name="OutputPreviewText"
                               Margin="0,6,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="输出目录将显示在这里" />
                </StackPanel>

                <Button x:Name="OpenOutputBtn"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,18,0"
                        Padding="16,10"
                        Click="OpenOutput_Click"
                        Style="{StaticResource SecondaryButton}"
                        Content="打开输出目录" />
            </Grid>
        </Border>

        <Border x:Name="DropOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="3"
                Margin="8"
                Background="#A8E7F4FF"
                BorderBrush="#4E94FF"
                BorderThickness="2"
                CornerRadius="32"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Path Width="54"
                      Height="54"
                      Fill="#4E94FF"
                      Stretch="Uniform"
                      Data="{StaticResource ImageIconGeometry}" />
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#163A5E"
                           Text="&#x62D6;&#x62FD;&#x56FE;&#x7247;&#x6216;&#x6587;&#x4EF6;&#x5939;&#x5230;&#x8FD9;&#x91CC;" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Foreground="#31577E"
                           Text="&#x652F;&#x6301; PNG / JPG / WEBP / BMP" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
