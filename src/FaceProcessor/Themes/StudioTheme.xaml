<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="BodyFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code</FontFamily>

    <Geometry x:Key="ImageIconGeometry">F1 M 4,3 L 20,3 C 21.1046,3 22,3.89543 22,5 L 22,19 C 22,20.1046 21.1046,21 20,21 L 4,21 C 2.89543,21 2,20.1046 2,19 L 2,5 C 2,3.89543 2.89543,3 4,3 Z M 5,7 L 5,17.8 L 9.6,13.2 L 12.6,16.2 L 17,10.8 L 19,13.3 L 19,7 Z M 8,8.3 C 6.95079,8.3 6.1,9.15079 6.1,10.2 C 6.1,11.2492 6.95079,12.1 8,12.1 C 9.04921,12.1 9.9,11.2492 9.9,10.2 C 9.9,9.15079 9.04921,8.3 8,8.3 Z</Geometry>
    <Geometry x:Key="FolderIconGeometry">F1 M 3,6.5 C 3,5.11929 4.11929,4 5.5,4 L 9.6,4 C 10.2444,4 10.8624,4.25893 11.3159,4.71967 L 12.5,5.9 L 18.5,5.9 C 19.8807,5.9 21,7.01929 21,8.4 L 21,18.5 C 21,19.8807 19.8807,21 18.5,21 L 5.5,21 C 4.11929,21 3,19.8807 3,18.5 Z</Geometry>
    <Geometry x:Key="VideoIconGeometry">F1 M 4.5,4 L 15.5,4 C 16.8807,4 18,5.11929 18,6.5 L 18,9.1 L 21.5,6.8 L 21.5,18.2 L 18,15.9 L 18,18.5 C 18,19.8807 16.8807,21 15.5,21 L 4.5,21 C 3.11929,21 2,19.8807 2,18.5 L 2,6.5 C 2,5.11929 3.11929,4 4.5,4 Z M 9,8 L 9,17 L 15,12.5 Z</Geometry>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9F4FF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F7FBFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="CardBrush" Color="#CFFFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#F8FBFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#8FC7F7" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4D9BFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2738" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6881" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#8090AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#368BFF" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#2F73FF" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#12326B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1FA27A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E58A2B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E35F6E" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#7F2832" />
    <SolidColorBrush x:Key="ChipBrush" Color="#F2F7FF" />

    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6CC7FF" Offset="0" />
        <GradientStop Color="#3477FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF9A9F" Offset="0" />
        <GradientStop Color="#F06A81" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3879FF" Offset="0" />
        <GradientStop Color="#56BFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DBF7FBFF" Offset="0" />
        <GradientStop Color="#C5E6FF" Offset="0.48" />
        <GradientStop Color="#B8D6F5" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4FBFF" Offset="0" />
        <GradientStop Color="#E9F5FF" Offset="0.58" />
        <GradientStop Color="#E2F0FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScrollThumbBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9BD6FF" Offset="0" />
        <GradientStop Color="#4D94FF" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    </Style>

    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HeroSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
    </Style>

    <Style x:Key="ShellBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#68FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="48"
                                  ShadowDepth="0"
                                  Color="#3B72A8"
                                  Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="#A4D6FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Color="#2F74C2"
                                  Opacity="0.08" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#EAF4FF" />
        <Setter Property="BorderBrush" Value="#AAD4FF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="WindowIconBadge" TargetType="Border" BasedOn="{StaticResource IconBadge}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="#E5F5FF" />
        <Setter Property="BorderBrush" Value="#9FD1FF" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style x:Key="TitleBarLogoBadge" TargetType="Border" BasedOn="{StaticResource IconBadge}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#D9ECFF" />
        <Setter Property="BorderBrush" Value="#A4CFFF" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <Style x:Key="MetricChip" TargetType="Border">
        <Setter Property="Background" Value="#EEF6FF" />
        <Setter Property="BorderBrush" Value="#A4D3FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <Style x:Key="RuntimeBadgeBorder" TargetType="Border" BasedOn="{StaticResource MetricChip}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="RuntimeBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        <Setter Property="BorderBrush" Value="#7CC2FF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#F6FAFF" />
        <Setter Property="BorderBrush" Value="#B0D8FF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerButtonBrush}" />
        <Setter Property="BorderBrush" Value="#FF9DA4" />
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#C4E8FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#AAD8FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#F26A75" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D85A67" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedTabControl" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  Margin="0,10,0,26"
                                  HorizontalAlignment="Center"
                                  Panel.ZIndex="2"
                                  Background="Transparent"
                                  IsItemsHost="True" />
                        <ContentPresenter Grid.Row="1"
                                          Margin="0,6,0,0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="44,18" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,8,0,0">
                        <Border x:Name="HeaderBorder"
                                Background="#F2FAFF"
                                BorderBrush="#A7D5FF"
                                BorderThickness="1.2"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <Border x:Name="GlowRing"
                                Margin="-2,-2,-2,-2"
                                Background="#00FFFFFF"
                                BorderBrush="#00000000"
                                BorderThickness="0"
                                CornerRadius="26" />
                        <Ellipse x:Name="Accent"
                                 Width="44"
                                 Height="8"
                                 Margin="0,0,0,-14"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Fill="#00000000" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FCFEFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#F7FCFF" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#76B8FF" />
                            <Setter TargetName="HeaderBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="30"
                                                      ShadowDepth="0"
                                                      Color="#58AFFF"
                                                      Opacity="0.34" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="GlowRing" Property="BorderBrush" Value="#7DBBFF" />
                            <Setter TargetName="GlowRing" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Accent" Property="Fill" Value="#56BFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#F8FBFF" />
        <Setter Property="BorderBrush" Value="#B8D8F6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Outer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter TargetName="Outer" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#F8FBFF" />
        <Setter Property="BorderBrush" Value="#B8D8F6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Popup x:Name="Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Margin="0,6,0,0"
                                    Padding="6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Background="#F8FBFF"
                                    BorderBrush="#A6D2FF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>

                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <ContentPresenter Margin="12,0,34,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <TextBlock Margin="0,0,12,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="▼" />
                            </Grid>
                        </Border>

                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Opacity="0.01" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter TargetName="Outer" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Margin="0,2"
                            Background="Transparent"
                            CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#E8F4FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#D8ECFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptionChipBorder" TargetType="Border">
        <Setter Property="Background" Value="#F6FAFF" />
        <Setter Property="BorderBrush" Value="#B6D7F7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="ChoiceChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip"
                            Background="#F6FAFF"
                            BorderBrush="#B6D7F7"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="#DDEEFF" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckChip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chip"
                            Background="#F6FAFF"
                            BorderBrush="#B6D7F7"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,8">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="#DDEEFF" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="#D8E7F8" />
        <Setter Property="Foreground" Value="{StaticResource ProgressBrush}" />
    </Style>

    <Style x:Key="GlassSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="#FDFEFF"
                                 Stroke="#87C4FF"
                                 StrokeThickness="1.5" />
                        <Ellipse Margin="5"
                                 Fill="#4B95FF" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0,4">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Background="#D7E8FA"
                                              BorderThickness="0"
                                              Height="6"
                                              Template="{DynamicResource SliderTrackButtonTemplate}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlassSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Background="#EAF2FB"
                                              BorderThickness="0"
                                              Height="6"
                                              Template="{DynamicResource SliderTrackButtonTemplate}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SliderTrackButtonTemplate" TargetType="RepeatButton">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="999" />
    </ControlTemplate>

    <Style x:Key="GlassScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource ScrollThumbBrush}"
                            CornerRadius="999"
                            Margin="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassScrollBarButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root"
                          Margin="1">
                        <Border x:Name="TrackBg"
                                Background="#5EEAF4FF"
                                CornerRadius="999"
                                Margin="2" />
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource GlassScrollBarButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlassScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource GlassScrollBarButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="TrackBg" Property="Margin" Value="4,2,4,2" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="12" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter TargetName="TrackBg" Property="Margin" Value="2,4,2,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ThemedListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Margin="0,0,0,6"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#EEF6FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#DDEEFF" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8EC5FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
