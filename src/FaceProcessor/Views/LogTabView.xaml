<UserControl x:Class="FaceProcessor.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="PrimaryBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2196F3" Offset="0"/>
            <GradientStop Color="#21CBF3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F44336" Offset="0"/>
            <GradientStop Color="#E91E63" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBtnGrad}"/>
        </Style>

        <!-- 日志 ListBox 项样式 -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="📋 调试日志" FontSize="16" FontWeight="SemiBold"
                       Foreground="#64B5F6" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="📋 复制全部" Click="CopyAll_Click"
                    Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
            <Button Content="🔍 复制选中" Click="CopySelected_Click"
                    Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
            <Button Content="🗑 清空日志" Click="Clear_Click"
                    Style="{StaticResource DangerBtn}"/>
            <TextBlock Name="CountText" Text="共 0 条" Foreground="#888888"
                       VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/>
        </StackPanel>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Background="#1A1A28" CornerRadius="8" BorderBrush="#303050" BorderThickness="1">
            <ListBox x:Name="LogListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource LogItemStyle}"
                     FontFamily="Consolas, Courier New"
                     FontSize="12"
                     Foreground="#CCCCCC"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Formatted}" TextWrapping="NoWrap" ToolTip="{Binding Formatted}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
