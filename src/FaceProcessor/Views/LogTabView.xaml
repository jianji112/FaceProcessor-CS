<UserControl x:Class="FaceProcessor.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24,0,24,24">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource SectionTitle}"
                               Text="运行日志" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,10,0"
                                Click="CopyAll_Click"
                                Style="{StaticResource SecondaryButton}"
                                Content="复制全部" />
                        <Button Margin="0,0,10,0"
                                Click="CopySelected_Click"
                                Style="{StaticResource SecondaryButton}"
                                Content="复制选中" />
                        <Button Margin="0,0,10,0"
                                Click="OpenLogFile_Click"
                                Style="{StaticResource SecondaryButton}"
                                Content="打开日志文件" />
                        <Button Click="Clear_Click"
                                Style="{StaticResource DangerButton}"
                                Content="清空" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CountText"
                               Margin="0,0,0,10"
                               Style="{StaticResource CaptionText}"
                               Text="0 条" />
                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             ItemContainerStyle="{StaticResource ThemedListBoxItem}"
                             SelectionMode="Extended"
                             Style="{StaticResource ThemedListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource MonoFont}"
                                               FontSize="12"
                                               Text="{Binding Formatted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
