<UserControl x:Class="FaceProcessor.Views.VideoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <LinearGradientBrush x:Key="PrimaryBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2196F3" Offset="0"/>
            <GradientStop Color="#21CBF3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F44336" Offset="0"/>
            <GradientStop Color="#E91E63" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessBtnGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#8BC34A" Offset="1"/>
        </LinearGradientBrush>
        
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button" x:Key="SuccessBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource SuccessBtnGrad}"/>
        </Style>
        
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBtnGrad}"/>
        </Style>
        
        <Style TargetType="ComboBox" x:Key="ModernCb">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Fill="White" Stretch="Uniform" 
                                      Width="12" Height="6" Margin="5,0,5,0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Data="M0,0 L6,6 L12,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        
        <Style TargetType="TextBox" x:Key="ModernTb">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 视频选择区 -->
            <GroupBox Grid.Row="0" Header="🎬 视频文件" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="VideoPathTextBox" Width="400" IsReadOnly="True"
                                 Style="{StaticResource ModernTb}" Margin="0,0,10,0"/>
                        <Button Content="📁 选择视频" Click="SelectVideo_Click" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                    <TextBlock Name="GpuStatusText" Text="⚠️ CPU 模式（较慢）" 
                               Foreground="#FFA726" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 处理设置区 -->
            <GroupBox Grid.Row="1" Header="⚙️ 处理设置" Foreground="White" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="处理模式" VerticalAlignment="Center" Width="70" Foreground="#AAAAAA"/>
                    <ComboBox Name="ModeCombo" Width="100" SelectedIndex="0" Style="{StaticResource ModernCb}">
                        <ComboBoxItem Content="马赛克"/>
                        <ComboBoxItem Content="高斯模糊"/>
                    </ComboBox>
                    
                    <TextBlock Text="块大小" VerticalAlignment="Center" Margin="25,0,0,0" 
                               Width="50" Foreground="#AAAAAA"/>
                    <TextBox Name="BlockSizeTextBox" Width="50" Text="0" Style="{StaticResource ModernTb}"/>
                    <TextBlock Text="(0=自动)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#888888"/>
                    
                    <TextBlock Text="模糊强度" VerticalAlignment="Center" Margin="25,0,0,0" 
                               Width="60" Foreground="#AAAAAA"/>
                    <TextBox Name="BlurStrengthTextBox" Width="50" Text="99" Style="{StaticResource ModernTb}"/>
                </StackPanel>
            </GroupBox>

            <!-- 输出设置区 -->
            <GroupBox Grid.Row="2" Header="📁 输出设置" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="OutputPathTextBox" Width="400" 
                                 Style="{StaticResource ModernTb}" Margin="0,0,10,0"/>
                        <Button Content="浏览..." Click="BrowseOutput_Click" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                    <CheckBox Name="KeepAudioCheckBox" Content="🔊 保留音频" 
                              IsChecked="True" Foreground="#CCCCCC" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 进度和按钮 -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border Background="#2A2A4A" CornerRadius="10" Padding="3" Margin="0,0,0,10">
                    <ProgressBar Name="ProgressBar" Height="20" Background="Transparent" 
                                 Foreground="{StaticResource SuccessBtnGrad}" Value="0"
                                 BorderThickness="0"/>
                </Border>
                <TextBlock Name="ProgressText" Text="" Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Name="StatusText" Text="就绪" Foreground="#CCCCCC" 
                           Margin="0,5,0,10" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="ProcessBtn" Content="▶ 开始处理" Click="Process_Click"
                            Style="{StaticResource SuccessBtn}" Padding="40,15" FontSize="16" 
                            Margin="0,0,20,0"/>
                    <Button Name="CancelBtn" Content="⏹ 取消" Click="Cancel_Click"
                            Style="{StaticResource DangerBtn}" Padding="25,15" FontSize="16" 
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
