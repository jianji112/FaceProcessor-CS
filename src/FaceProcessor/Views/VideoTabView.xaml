<UserControl x:Class="FaceProcessor.Views.VideoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,18,18"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Margin="0,0,0,12"
                        Click="SelectVideo_Click"
                        Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="18"
                                   Text="&#xE714;" />
                        <TextBlock FontSize="16"
                                   Text="选择视频" />
                    </StackPanel>
                </Button>

                <TextBox x:Name="VideoPathTextBox"
                         Grid.Row="1"
                         Margin="0,0,0,12"
                         IsReadOnly="True"
                         Style="{StaticResource TextInput}" />

                <Border Grid.Row="2"
                        Margin="0,0,0,16"
                        Padding="14"
                        Style="{StaticResource OptionChipBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="运行链路" />
                        <TextBlock x:Name="GpuStatusText"
                                   FontWeight="SemiBold"
                                   Text="检测后端：初始化中" />
                        <TextBlock x:Name="EngineSummaryText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="编码后端：初始化中" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Padding="16"
                        BorderBrush="#A6D2FF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Background="#8EFFFFFF">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10"
                                   Style="{StaticResource SectionTitle}"
                                   Text="视频信息" />
                        <TextBlock x:Name="VideoInfoText"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedText}"
                                   Text="选择视频后显示分辨率、帧率和时长。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,18,18"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource SectionTitle}"
                               Text="视频预览" />
                    <TextBlock x:Name="PreviewSummaryText"
                               DockPanel.Dock="Right"
                               Style="{StaticResource CaptionText}"
                               Text="尚未加载视频帧" />
                </DockPanel>

                <Border Grid.Row="1"
                        CornerRadius="28"
                        Background="#ECF6FF"
                        BorderBrush="#9FCEFF"
                        BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Margin="20"
                               Stretch="Uniform" />
                        <TextBlock x:Name="PreviewPlaceholderText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Text="选择视频后显示首帧预览" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="视频输出优先使用 NVIDIA NVENC；如不可用会自动回退到 CPU 编码。" />
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,0,18"
                Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource SectionTitle}"
                               Text="处理设置" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="处理模式" />
                    <ComboBox x:Name="ModeCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="马赛克" />
                        <ComboBoxItem Content="模糊" />
                    </ComboBox>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="检测阈值" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   x:Name="FaceThresholdText"
                                   Style="{StaticResource FieldLabel}"
                                   Text="0.35" />
                    </DockPanel>
                    <Slider x:Name="FaceThresholdSlider"
                            Minimum="0.1"
                            Maximum="0.9"
                            TickFrequency="0.05"
                            Value="0.35" />

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="马赛克块尺寸" />
                    <TextBox x:Name="BlockSizeTextBox"
                             Style="{StaticResource TextInput}" />

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="模糊强度" />
                    <TextBox x:Name="BlurStrengthTextBox"
                             Style="{StaticResource TextInput}" />

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="每帧处理的人脸数" />
                    <ComboBox x:Name="VideoFaceCountCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="只处理 1 张脸" />
                        <ComboBoxItem Content="处理 2 张脸" />
                        <ComboBoxItem Content="处理 3 张脸" />
                        <ComboBoxItem Content="全部处理" />
                    </ComboBox>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="输出分辨率" />
                    <ComboBox x:Name="OutputResolutionCombo"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              Style="{StaticResource ThemedComboBox}">
                        <ComboBoxItem Content="原分辨率" />
                        <ComboBoxItem Content="短边 1080" />
                        <ComboBoxItem Content="短边 720" />
                    </ComboBox>

                    <CheckBox x:Name="KeepAudioCheckBox"
                              Margin="0,18,0,0"
                              Style="{StaticResource CheckChip}"
                              Content="保留原始音轨" />

                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="输出文件路径" />
                    <TextBox x:Name="OutputPathTextBox"
                             Margin="0,0,0,10"
                             Style="{StaticResource TextInput}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Click="BrowseOutput_Click"
                                Style="{StaticResource SecondaryButton}"
                                Content="选择输出目录" />
                        <Button x:Name="OpenOutputDirectoryBtn"
                                Margin="10,0,0,0"
                                Click="OpenOutputDirectory_Click"
                                Style="{StaticResource SecondaryButton}"
                                Content="打开输出目录" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="0"
                             Grid.Column="0"
                             Margin="0,0,18,12"
                             Height="14"
                             Maximum="100"
                             Style="{StaticResource ThemedProgressBar}" />
                <TextBlock x:Name="ProgressText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,18,10"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="0%" />

                <Button x:Name="ProcessBtn"
                        Grid.Row="0"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Height="74"
                        Margin="0,0,10,0"
                        Click="Process_Click"
                        Style="{StaticResource PrimaryButton}">
                    <TextBlock FontSize="20"
                               Text="开始处理" />
                </Button>
                <Button x:Name="CancelBtn"
                        Grid.Row="0"
                        Grid.Column="3"
                        Grid.RowSpan="2"
                        Height="74"
                        Click="Cancel_Click"
                        Style="{StaticResource DangerButton}"
                        Visibility="Collapsed">
                    <TextBlock FontSize="20"
                               Text="取消任务" />
                </Button>

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="等待开始" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
